# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FOOTBALL_API_KEY: Bezpłatny token autoryzacyjny ze strony football-data.org do zasilania aplikacji prawdziwymi meczami z całego świata.
FOOTBALL_API_KEY=""

# VITE_API_BASE_URL: Adres bazowy zewnętrznego API backendu (np. przy hostingu statycznego frontendu na GitHub Pages). Domyślnie pusty (wywołania lokalne /api/...).
VITE_API_BASE_URL=""

# ALLOWED_ORIGIN: Dozwolony origin dla zapytań CORS w backendzie (np. https://lukasz8423-code.github.io). Jeśli nieustawione, CORS nie jest ograniczany.
ALLOWED_ORIGIN=""


